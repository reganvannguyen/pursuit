{
  "expo": {
    "name": "pursuit",
    "slug": "pursuit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pursuit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.regannguyen.pursuit",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.regannguyen.pursuit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIosSceneLifecycle",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pursuit uses your location to track the distance and route of an active run."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "400402d3-0b79-414e-9883-12dd14664d6c"
      }
    },
    "owner": "regannguyen"
  }
}
